{
  "name": "repo2-playwright-api",
  "version": "1.0.0",
  "description": "API test suite for the Restful-Booker API using Playwright's request fixture, TypeScript and zod schema validation, with GitHub Actions CI.",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "report": "playwright show-report",
    "allure:generate": "npx -y allure-commandline generate allure-results --clean -o allure-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "allure-playwright": "^3.15.0",
    "dotenv": "^18.0.10",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  }
}
